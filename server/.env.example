# Copy this to .env (or set these as Environment Variables in cPanel's
# "Setup Node.js App" screen). Do NOT commit real secrets.

NODE_ENV=production

# REQUIRED: a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="paste-a-long-random-string-here"

# Where the data file lives. Defaults to ./data/data.json in the app folder.
# DATA_FILE="/home/USER/expenses-tracker/data/data.json"

# REQUIRED for Google Sign-In: the public OAuth "Client ID" from Google Cloud
# Console (APIs & Services -> Credentials). Safe to expose; it's sent to the
# browser to render the sign-in button.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"

# ONE-TIME LINK (recommended on first deploy): connect your Google email to your
# existing account so your data carries over instead of starting empty. Format is
# "email:username", comma-separated for several. It only fills a missing email, so
# it's safe to leave; remove it after your first successful Google sign-in.
#   LINK_ACCOUNTS="you@gmail.com:nikos"

# Passenger sets the port itself, so PORT is ignored under cPanel.
PORT=4000
