# Dependencies (reinstall with `npm install` in client/ and server/)
node_modules/

# Secrets & environment — NEVER commit these
.env
.env.*
!.env.example

# Personal financial data (lives on the server; back it up separately)
server/data/

# Build outputs (regenerated by the build)
client/dist/
server/public/

# Deploy + backup artifacts (regenerated / large binaries)
deploy/
backups/
*.zip

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Databases, logs, OS/editor cruft
*.db
*.log
.DS_Store
Thumbs.db
.vscode/
